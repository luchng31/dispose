# Copy to .env and fill every empty value. NEVER commit .env.
# cp .env.example .env && chmod 600 .env
#
# Secrets (no defaults — compose fails fast with a clear error if unset):
#   POSTGRES_PASSWORD, DJANGO_SECRET_KEY, JWT_SECRET_KEY,
#   FTP_PASS, WATCHER_TOKEN, PASV_ADDRESS, FTP_USER,
#   DJANGO_ALLOWED_HOSTS (required since the fail-fast hardening: no silent `*`)
# Conditionally required (empty default is fine until the feature is used):
#   CMDB_TOKEN (cmdb sync), WECOM_SECRET (WeCom login)

# --- Postgres 16 ---
POSTGRES_DB=vulntickets
POSTGRES_USER=vuln
POSTGRES_PASSWORD=CHANGE_ME_postgres_32plus_chars

# --- Django / DRF / JWT ---
DJANGO_SECRET_KEY=CHANGE_ME_django_50plus_chars
DJANGO_DEBUG=false
# REQUIRED: compose fails fast if empty (no silent `*` default in production).
# Set to the real intranet hostname(s), comma-separated, e.g.:
DJANGO_ALLOWED_HOSTS=vuln.internal.example.com
JWT_SECRET_KEY=CHANGE_ME_jwt_32plus_chars_different_from_django
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Celery ---
CELERY_TIMEZONE=Asia/Shanghai
CELERY_LOGLEVEL=INFO
CELERY_CONCURRENCY=2

# --- CMDB pull (Task4; hourly beat once backend adds CELERY_BEAT_SCHEDULE) ---
# DB-overridable at runtime: env is the fallback default; edits on the
# /ops/config page (admin, GET/PUT /api/ops/integrations) win immediately
# with no backend restart. Clearing a value on the page falls back to env.
CMDB_BASE_URL=https://cmdb.example
CMDB_TOKEN=
# Cursor path INSIDE worker/beat containers (backed by cmdb-cursor volume).
# Matches backend/apps/cmdb/tasks.py CMDB_CURSOR_FILE contract.

# --- WeCom scan login (Task2) ---
# DB-overridable at runtime (env = fallback default, page edit wins, no restart).
WECOM_CORPID=
WECOM_SECRET=

# --- FTP drop (vsftpd, plaintext => INTRANET ONLY) ---
FTP_USER=rsas
FTP_PASS=CHANGE_ME_ftp_20plus_chars
FTP_UID=1001
FTP_GID=1001
FTP_PORT=21
# !!! MUST be the host's intranet IP (e.g. 192.168.1.10). NEVER 127.0.0.1:
# PASV data connections fail otherwise for every LAN client.
PASV_ADDRESS=192.168.1.10
PASV_MIN_PORT=40000
PASV_MAX_PORT=40100

# --- Watcher -> import API ---
# Scoped operator API token (JWT for an operator/service account).
WATCHER_TOKEN=CHANGE_ME_watcher_operator_jwt
WATCHER_POLL_INTERVAL=15
WATCHER_PATTERN=*.zip
# Safety latch: true => POST ?dry_run=true (preview only, zero DB writes).
# Default is true (preview-only) until the FTP->watcher->API pipeline is
# trusted end-to-end; set false EXPLICITLY to opt in to live DB writes.
# Compose default is also true, so an unset value is safe.
WATCHER_DRY_RUN=true

# --- Frontend build args (Vite bakes them into the bundle at `docker compose
# build web`; changing them later requires rebuilding the web image) ---
# Empty VITE_API_BASE => same-origin /api behind the companion nginx. Only set
# it if the API lives on a DIFFERENT origin than the web frontend.
VITE_API_BASE=
# WeCom QR login: needs an ICP-filed trusted domain; on pure-intranet IP
# deployments leave empty (login page falls back to local accounts + TOTP).
VITE_WECOM_CORPID=
VITE_WECOM_AGENTID=

# --- Web ingress ---
WEB_HTTP_PORT=80
# WEB_HTTPS_PORT=443

# --- Corporate email (SMTP notifications: assign/submit/close/reject/SLA) ---
# DB-overridable at runtime: env is the fallback default; edits on the
# /ops/config page (admin, GET/PUT /api/ops/integrations) win immediately
# with no backend restart. SMTP_* + NOTIFY_* below are all page-editable.
# Enterprise mailbox e.g. Exmail/QQ-enterprise:
# host smtp.exmail.qq.com port 465 SSL on; or port 587 TLS on.
NOTIFY_ENABLED=false
EMAIL_HOST=smtp.exmail.qq.com
EMAIL_PORT=465
EMAIL_HOST_USER=sec@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=sec@example.com
NOTIFY_SUBJECT_PREFIX=【漏洞工单】
# DB-overridable at runtime (env = fallback default, page edit wins, no restart).
NOTIFY_WECOM_WEBHOOK=
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_SECONDS=900

# --- 生产投产检查单 (go-live checklist; verify each line before `docker compose up -d`) ---
# 1. ALLOWED_HOSTS 已填真实内网域名 (DJANGO_ALLOWED_HOSTS, 非 `*`; 为空则 compose 直接报错拒绝启动)。
# 2. DEBUG 保持 false (DJANGO_DEBUG=false; 为 true 会泄露堆栈, 生产严禁开启)。
# 3. JWT_SECRET 与 DJANGO_SECRET 互不相同、各 32+ 随机字符, 且均非示例占位值。
# 4. FTP 仅限内网 (PASV_ADDRESS=本机内网 IP, 绝不用 127.0.0.1; 防火墙只放行内网源的 21 + 40000-40100/tcp)。
# 5. WATCHER_DRY_RUN 意图已确认: true=仅预览零写库 (联调/首投用), false=正式写库 (需显式 opt-in)。
# 6. media 卷 (media-data) 已纳入备份 (工单证据图); db-data 定期 pg_dump, 并做过一次恢复演练。
